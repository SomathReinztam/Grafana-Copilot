# --- Grafana ---
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# --- Base de datos del usuario (para pruebas: northwind) ---
# Desde el contenedor de Grafana, el host se alcanza como host.docker.internal.
DB_HOST=host.docker.internal
DB_PORT=5434
DB_USER=postgres
DB_PASS=postgres
DB_NAME=northwind

# --- Backend / Agente ---
# Grafana URL que ve el BACKEND (corre en el host, no en el contenedor)
GRAFANA_URL=http://localhost:3000
# LLM (Gemini) — NO commitear la clave real
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
