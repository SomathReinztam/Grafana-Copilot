# Grafana visto desde el BACKEND (corre en el host)
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Base de datos del usuario (para pruebas: northwind, publicado en el host)
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASS=postgres
DB_NAME=northwind

# LLM (Gemini) — NO commitear la clave real
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
